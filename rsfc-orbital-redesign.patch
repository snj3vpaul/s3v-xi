+@keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(63, 211, 138, 0); } 100% { box-shadow: 0 0 0 0 rgba(63, 211, 138, 0); } }
+
+/* ---------- Scoreline (season numbers) ---------- */
+.scoreline { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line-soft); }
+.score-cell { padding: 1.75rem 1rem 1.6rem 0; }
+.score-cell + .score-cell { padding-left: 1.25rem; border-left: 1px solid var(--line-soft); }
+.score-cell .v { font-family: var(--display); font-weight: 800; font-size: clamp(2.4rem, 6vw, 4.2rem); line-height: 0.9; }
+.score-cell .l { color: var(--muted); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 0.45rem; }
+
+/* ---------- How it works: the pitch ---------- */
+.pitch-section { padding: 5rem 0; }
+.pitch-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 3.5rem; align-items: center; }
+.pitch-copy h2 { margin-top: 0.6rem; font-size: clamp(2rem, 4.4vw, 3.2rem); }
+.pitch-steps { list-style: none; padding: 0; margin: 1.75rem 0 0; }
