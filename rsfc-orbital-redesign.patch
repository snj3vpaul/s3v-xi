+}
+.skip-link:focus { top: 0.6rem; text-decoration: none; }
+#content:focus { outline: none; }
+
+.text-link {
+  display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px;
+  font-family: var(--display); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: 1rem;
+  color: var(--chalk);
+}
+.text-link span { transition: transform 0.2s ease; }
+.text-link:hover { color: var(--kit); text-decoration: none; }
+.text-link:hover span { transform: translateX(3px); }
+.btn-lg { min-height: 54px; padding: 0.9rem 1.7rem; font-size: 1.15rem; }
+
+/* ---------- Lenis ---------- */
+html.lenis, html.lenis body { height: auto; }
+.lenis.lenis-smooth { scroll-behavior: auto !important; }
+.lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
+.lenis.lenis-stopped { overflow: hidden; }
+
+/* ---------- Hero ---------- */
+.hero-stage {
+  position: relative; isolation: isolate; overflow: hidden;
+  min-height: min(92svh, 880px);
+  display: flex; align-items: flex-end;
+  border-bottom: 1px solid var(--line-soft);
+}
+/* The CSS fallback is a still of the shader: floodlight haze over mown stripes. */
+.floodlit {
+  position: absolute; inset: 0; z-index: -2;
+  background:
+    radial-gradient(40% 50% at 4% -4%, rgba(170, 190, 170, 0.16), transparent 70%),
+    radial-gradient(40% 50% at 96% -4%, rgba(170, 190, 170, 0.16), transparent 70%),
+    linear-gradient(to bottom, transparent 44%, rgba(46, 120, 76, 0.18) 60%, rgba(46, 120, 76, 0.32)),
+    repeating-linear-gradient(to bottom, transparent 0 46px, rgba(255, 255, 255, 0.018) 46px 92px),
+    var(--navy-900);
+}
+.floodlit canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 1.4s ease; }
+.floodlit.is-live canvas { opacity: 1; }
+/* Readability scrim: the copy always sits on dark, whatever the shader does. */
+.hero-stage::after {
+  content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
+  background:
+    linear-gradient(90deg, rgba(12, 25, 37, 0.9) 0%, rgba(12, 25, 37, 0.62) 42%, rgba(12, 25, 37, 0) 78%),
+    linear-gradient(to top, var(--navy-900) 0%, rgba(12, 25, 37, 0) 32%);
+}
+.hero-inner { padding: 7rem 0 4.5rem; }
+.hero-stage .eyebrow {
+  font-family: var(--display); letter-spacing: 0.22em; text-transform: uppercase; color: var(--kit);
+  font-weight: 600; font-size: 0.95rem; margin: 0;
+}
+.hero-title { font-size: clamp(3.4rem, 15vw, 8.75rem); font-weight: 800; line-height: 0.88; margin-top: 1rem; max-width: 12ch; }
+.hero-title em { color: var(--kit); }
+.hero-title .w { display: inline-block; overflow: hidden; vertical-align: top; padding: 0 0.07em 0.06em 0; margin-right: -0.07em; }
+.hero-title .w > span {
+  display: inline-block;
+  animation: word-up 0.95s cubic-bezier(0.2, 0.75, 0.2, 1) both;
+  animation-delay: calc(var(--i, 0) * 75ms + 120ms);
+}
+.hero-in { animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i, 0) * 75ms + 120ms); }
+@keyframes word-up { from { transform: translateY(108%); } }
+.hero-stage .lede { margin: 1.4rem 0 0; font-size: 1.15rem; max-width: 46ch; color: var(--chalk-2); }
+.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; margin-top: 2rem; }
