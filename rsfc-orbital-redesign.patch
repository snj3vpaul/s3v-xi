+.mascot .eyes { transform-origin: 50% 50%; animation: mascot-blink 5s infinite; animation-delay: calc(var(--phase, 0) * -5s); }
+.mascot .arm-r { transform-origin: 20% 10%; }
+.mascot.is-landing { transform-origin: 50% 100%; animation: mascot-land 0.55s cubic-bezier(0.3, 1.6, 0.5, 1); }
+.mascot.is-landing .arm-r { animation: mascot-wave 0.5s ease-in-out 0.35s 2; }
+.chip-face:hover .mascot .eyes, .bench-slot:hover .mascot .eyes { animation-duration: 0.9s; }
