+/**
+ * Squad mascots: one original cartoon footballer per player.
+ *
+ * Every look is generated from the player's id, so each of the 21 is different
+ * and stays the same everywhere. To make a mascot look more like the real
+ * person, add an override below; anything you leave out stays generated.
+ *
+ *   sanjeev: { hair: "quiff", hairColor: "#1b1410", beard: true },
+ */
+export const HAIR_STYLES = ["buzz", "curly", "quiff", "spiky", "bald", "sidepart", "topknot", "mop"] as const;
+export const EYE_STYLES = ["round", "dot", "happy"] as const;
+export const MOUTHS = ["grin", "smile", "o", "smirk"] as const;
+
+export type HairStyle = (typeof HAIR_STYLES)[number];
+export type EyeStyle = (typeof EYE_STYLES)[number];
+export type Mouth = (typeof MOUTHS)[number];
+
+export interface MascotLook {
+  skin: string;
+  hair: HairStyle;
+  hairColor: string;
+  eyes: EyeStyle;
+  mouth: Mouth;
+  beard: boolean;
+  boots: string;
+  socks: string;
+  /** Degrees; tilts the brows for a bit of attitude. */
+  brow: number;
+}
+
+export const SKIN_TONES = ["#f1c7a3", "#e2a77f", "#c98a5e", "#a8693f", "#8a5232", "#6b3d24"];
+export const HAIR_COLORS = ["#16110e", "#2b1d15", "#4a3020", "#7a4a2a", "#b98a4e", "#8f8f8f"];
+export const BOOT_COLORS = ["#3fd38a", "#ff8a3d", "#ff5fa2", "#3ac8e8", "#f2efe6", "#e9b949", "#8f78e6"];
+export const SOCK_COLORS = ["#f2efe6", "#0c1925", "#3fd38a"];
+
+export const LOOK_OVERRIDES: Partial<Record<string, Partial<MascotLook>>> = {};
diff --git a/lib/league/mascot.ts b/lib/league/mascot.ts
new file mode 100644
index 0000000..cdcf1fe
--- /dev/null
+++ b/lib/league/mascot.ts
@@ -0,0 +1,57 @@
+import {
+  BOOT_COLORS,
+  EYE_STYLES,
+  HAIR_COLORS,
+  HAIR_STYLES,
+  LOOK_OVERRIDES,
+  MOUTHS,
+  SKIN_TONES,
+  SOCK_COLORS,
+  type MascotLook,
+} from "@/config/mascots";
+
+/** FNV-1a 32-bit: a stable number for a string. */
+function fnv(s: string): number {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < s.length; i++) {
+    h ^= s.charCodeAt(i);
+    h = Math.imul(h, 0x01000193);
+  }
+  return h >>> 0;
+}
+
+/** Small seeded PRNG (mulberry32) so one id always produces the same mascot. */
+function rng(seed: number) {
+  let a = seed;
+  return () => {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+const pick = <T,>(r: () => number, list: readonly T[]): T => list[Math.floor(r() * list.length)];
+
+/** The mascot look for a player id: generated, then any club overrides applied. */
+export function mascotLook(id: string): MascotLook {
+  const r = rng(fnv(id));
+  const hair = pick(r, HAIR_STYLES);
+  const generated: MascotLook = {
+    skin: pick(r, SKIN_TONES),
+    hair,
+    hairColor: hair === "bald" ? "transparent" : pick(r, HAIR_COLORS),
+    eyes: pick(r, EYE_STYLES),
+    mouth: pick(r, MOUTHS),
+    beard: r() < 0.35,
+    boots: pick(r, BOOT_COLORS),
+    socks: pick(r, SOCK_COLORS),
+    brow: Math.round((r() - 0.5) * 24),
+  };
+  return { ...generated, ...LOOK_OVERRIDES[id] };
+}
+
+/** Deterministic 0..1 value per id, for desynchronising idle animations. */
+export function mascotPhase(id: string): number {
+  return (fnv(`${id}:phase`) % 1000) / 1000;
+}
