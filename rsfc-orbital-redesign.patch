+.pitch-steps h3 { font-size: 1.4rem; }
+.pitch-steps p { margin: 0.35rem 0 0; color: var(--chalk-2); }
+.step-mark {
+  width: 2.1rem; height: 2.1rem; border-radius: 50%; display: grid; place-items: center;
+  border: 1.5px solid var(--kit); color: var(--kit); font-family: var(--display); font-weight: 800; font-size: 1.1rem;
+}
+.pitch-svg {
+  width: 100%; height: auto; border-radius: 16px; overflow: visible;
+  background:
+    repeating-linear-gradient(90deg, rgba(63, 211, 138, 0.075) 0 10%, rgba(63, 211, 138, 0.035) 10% 20%),
+    var(--navy-950);
+  box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.8), 0 0 0 1px var(--line-soft);
+}
+.pl { stroke: rgba(242, 239, 230, 0.55); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+.mk-ring { fill: none; stroke: var(--chalk); stroke-width: 2; }
+.mk-white { fill: #f4f4f0; }
+.mk-red { fill: #e0453a; }
+.mk-ball { fill: var(--chalk); }
+.mk-trail { stroke: var(--chalk); stroke-width: 2; stroke-dasharray: 3 5; opacity: 0.6; }
+.mk-pick { fill: var(--kit); stroke: var(--navy-950); stroke-width: 2; }
+.mk-label { fill: var(--chalk); font-family: var(--display); font-weight: 700; font-size: 17px; letter-spacing: 0.14em; text-anchor: middle; }
+.mk-plus { fill: var(--kit); font-size: 28px; font-weight: 800; }
+
+@media (min-width: 960px) and (min-height: 640px) {
+  /* Pinned on desktop: the section owns one screen while the steps play out. */
+  .pitch-section { min-height: 100vh; display: flex; align-items: center; padding: 4rem 0; }
+}
+@media (max-width: 959px) {
+  .pitch-grid { grid-template-columns: 1fr; gap: 2rem; }
+  .pitch-svg { order: -1; }
+}
+
+/* ---------- Fixture band + table ---------- */
+.home-tail { padding: 1rem 0 5rem; }
+.fixture-band {
+  display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.5rem;
+  padding: 2rem; border-radius: var(--radius); border: 1px solid var(--line-soft);
+  background: linear-gradient(120deg, rgba(63, 211, 138, 0.1), rgba(63, 211, 138, 0) 55%), var(--navy-800);
+}
+.fixture-band h2 { margin-top: 0.5rem; font-size: clamp(2rem, 5vw, 3.2rem); }
+.fixture-band h2 em { color: var(--muted); }
+.podium-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
+.podium-list li { display: grid; grid-template-columns: 3rem 1fr auto; align-items: center; gap: 0.75rem; padding: 1rem 0; border-bottom: 1px solid var(--line-soft); }
+.podium-list .rank { font-size: 1.6rem; color: var(--muted); width: auto; }
+.podium-list .who { font-family: var(--display); font-weight: 700; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.02em; }
+.podium-list .pts { font-size: 2rem; }
+.podium-list .pts small { font-size: 0.8rem; color: var(--muted); font-weight: 600; letter-spacing: 0.1em; }
+.podium-list li:first-child .rank, .podium-list li:first-child .pts { color: var(--kit); }
+
+@media (max-width: 560px) {
