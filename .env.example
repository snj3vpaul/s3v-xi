# Public client values. RLS protects data; never put service-role keys in NEXT_PUBLIC settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Predictor League (/league) — all optional for local dev (uses .data/league.sqlite + demo seed) ---
# Server-only Postgres connection (Supabase: use the transaction pooler URI, port 6543). Never NEXT_PUBLIC_.
DATABASE_URL=
# Whoever signs up with this email becomes the league admin (no invite code needed).
LEAGUE_ADMIN_EMAIL=
# Optional starting league name.
LEAGUE_NAME=
# 1 = seed demo players/rounds into an empty DB, 0 = never. Default: seed only when DATABASE_URL is unset.
LEAGUE_DEMO_SEED=
