# Admin passcode for scorecard entry, draws and settings (required in production).
ADMIN_PASSCODE=change-me

# Secret used to sign the admin cookie. Any long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Persistent storage on Vercel: connect an Upstash Redis (Vercel Marketplace → Upstash)
# and these are injected for you. Either naming pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: storage key prefix if you run several leagues on one Redis.
RSFC_STORAGE_KEY=rsfc:league

# --- Accounts ---------------------------------------------------------------
# Optional: require this code to create an account (share it in the club chat)
# so strangers who find the URL can't join.
SIGNUP_CODE=

# --- Weekly reminder emails (optional) --------------------------------------
# Free Resend account: https://resend.com → API key. To email everyone (not just
# yourself) verify a domain in Resend and set REMINDER_FROM to an address on it.
RESEND_API_KEY=
REMINDER_FROM="RSFC League <league@yourdomain.com>"
# Vercel sends this automatically to the cron route; any long random string.
CRON_SECRET=
# Used in email links (defaults to the request URL).
PUBLIC_BASE_URL=https://s3v-xi.vercel.app
