# Admin passcode for scorecard entry, draws and settings (required in production).
ADMIN_PASSCODE=change-me

# Secret used to sign the admin cookie. Any long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Persistent storage on Vercel: connect an Upstash Redis (Vercel Marketplace → Upstash)
# and these are injected for you. Either naming pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: storage key prefix if you run several leagues on one Redis.
RSFC_STORAGE_KEY=rsfc:league
